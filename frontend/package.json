{
  "name": "destinyone",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build:web",
    "check:all": "pnpm check && pnpm build:ios && pnpm build:android",
    "export:web": "expo export --platform web --output-dir dist/client && node scripts/fix-expo-web-fonts.mjs --output=dist/client && node scripts/prepare-sites-hosting.mjs",
    "build": "pnpm build:web",
    "build:web": "expo export --platform web --output-dir dist/client && node scripts/fix-expo-web-fonts.mjs --output=dist/client && node scripts/prepare-sites-hosting.mjs",
    "build:ios": "expo export --platform ios --output-dir dist-ios",
    "build:android": "expo export --platform android --output-dir dist-android",
    "release:check": "pnpm check:all"
  },
  "dependencies": {
    "@countrystatecity/countries-browser": "^1.0.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo-google-fonts/satisfy": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~55.0.0",
    "expo-audio": "~55.0.15",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.37",
    "expo-document-picker": "~55.0.15",
    "expo-font": "~55.0.4",
    "expo-image-picker": "~55.0.21",
    "expo-linear-gradient": "~55.0.3",
    "expo-location": "~55.1.11",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.20",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "nativewind": "^4.1.23",
    "react-native-css-interop": "^0.1.22"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4",
    "tailwindcss": "^3.4.13"
  }
}
